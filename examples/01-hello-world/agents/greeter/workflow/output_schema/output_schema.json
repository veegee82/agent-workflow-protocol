{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "greeting": {
      "type": "string",
      "description": "The personalized greeting message"
    },
    "tone": {
      "type": "string",
      "description": "The tone of the greeting (formal, casual, humorous, etc.)"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Confidence score for the greeting quality"
    }
  },
  "required": ["greeting", "tone", "confidence"]
}
