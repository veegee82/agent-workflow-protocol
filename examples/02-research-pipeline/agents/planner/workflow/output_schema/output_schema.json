{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "research_questions": {
      "type": "array",
      "items": {"type": "string"},
      "description": "List of specific research questions to investigate"
    },
    "search_strategy": {
      "type": "string",
      "description": "Strategy for conducting the research"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Confidence in the research plan quality"
    }
  },
  "required": ["research_questions", "search_strategy", "confidence"]
}
