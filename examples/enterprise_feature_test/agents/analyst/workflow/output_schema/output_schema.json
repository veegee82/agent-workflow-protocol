{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["analysis_summary", "risk_score", "recommendations", "confidence"],
  "properties": {
    "analysis_summary": {
      "type": "string",
      "description": "Zusammenfassung der Marktanalyse"
    },
    "risk_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Risikobewertung"
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "priority", "reason"],
        "properties": {
          "action": { "type": "string" },
          "priority": { "type": "string", "enum": ["high", "medium", "low"] },
          "reason": { "type": "string" }
        }
      },
      "description": "Handlungsempfehlungen"
    },
    "historical_comparison": {
      "type": "object",
      "properties": {
        "previous_risk_score": { "type": "number" },
        "trend_change": { "type": "string", "enum": ["improved", "stable", "deteriorated"] },
        "last_analysis_date": { "type": "string", "format": "date-time" }
      },
      "description": "Vergleich mit früheren Analysen"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Konfidenz der Analyse"
    }
  },
  "additionalProperties": false
}
