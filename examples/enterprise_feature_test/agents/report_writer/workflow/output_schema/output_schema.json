{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["final_report_path", "report_hash", "report_content", "confidence"],
  "properties": {
    "final_report_path": {
      "type": "string",
      "description": "Dateipfad zum generierten Report"
    },
    "report_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "SHA-256 Hash des Reports"
    },
    "report_content": {
      "type": "string",
      "minLength": 500,
      "description": "Vollständiger Report als Markdown"
    },
    "governance_log": {
      "type": "object",
      "properties": {
        "blocked_tools": { "type": "array", "items": { "type": "string" } },
        "rate_limit_hits": { "type": "integer" },
        "circuit_breaker_events": { "type": "integer" }
      },
      "description": "Governance-Event-Log"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Konfidenz der Report-Qualität"
    }
  },
  "additionalProperties": false
}
