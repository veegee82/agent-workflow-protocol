{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["raw_data", "data_sources", "confidence"],
  "properties": {
    "raw_data": {
      "type": "object",
      "description": "Gesammelte Rohdaten als strukturiertes Objekt"
    },
    "data_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "type", "quality"],
        "properties": {
          "url": { "type": "string" },
          "type": { "type": "string", "enum": ["web", "api", "custom"] },
          "quality": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      },
      "description": "Liste der verwendeten Datenquellen"
    },
    "screenshot_summary": {
      "type": "string",
      "description": "Zusammenfassung des analysierten Screenshots"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Konfidenz der Datenqualität"
    }
  },
  "additionalProperties": false
}
