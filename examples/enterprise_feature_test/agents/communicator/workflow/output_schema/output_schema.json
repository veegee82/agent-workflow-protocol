{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["consolidated_report", "broadcast_status", "confidence"],
  "properties": {
    "consolidated_report": {
      "type": "object",
      "properties": {
        "metrics": { "type": "object" },
        "analysis": { "type": "string" },
        "risk_score": { "type": "number" },
        "recommendations": { "type": "array" },
        "data_quality": { "type": "number" }
      },
      "description": "Konsolidierter Gesamtbericht"
    },
    "broadcast_status": {
      "type": "object",
      "required": ["messages_sent", "channels_used"],
      "properties": {
        "messages_sent": { "type": "integer" },
        "channels_used": { "type": "array", "items": { "type": "string" } },
        "recipients": { "type": "array", "items": { "type": "string" } },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "description": "Status der Broadcast-Nachrichten"
    },
    "message_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "to": { "type": "string" },
          "channel": { "type": "string" },
          "type": { "type": "string" },
          "content_preview": { "type": "string" }
        }
      },
      "description": "Log der Nachrichten"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Konfidenz der Konsolidierung"
    }
  },
  "additionalProperties": false
}
