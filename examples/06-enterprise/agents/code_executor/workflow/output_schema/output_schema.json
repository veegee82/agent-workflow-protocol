{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "computation_result": {
      "type": "object",
      "description": "Results of data computations"
    },
    "metrics": {
      "type": "object",
      "description": "Calculated metrics and statistics"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Confidence in computation accuracy"
    }
  },
  "required": ["computation_result", "metrics", "confidence"]
}
