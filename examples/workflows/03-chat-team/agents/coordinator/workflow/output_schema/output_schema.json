{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "task_breakdown": {
      "type": "array",
      "items": {"type": "string"},
      "description": "List of subtasks identified"
    },
    "assignments": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Task assignments sent to specialists"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Confidence in task coordination quality"
    }
  },
  "required": ["task_breakdown", "assignments", "confidence"]
}
