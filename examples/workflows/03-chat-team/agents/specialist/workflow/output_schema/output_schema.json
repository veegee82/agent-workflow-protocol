{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "analysis": {
      "type": "string",
      "description": "Detailed analysis results"
    },
    "recommendations": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Actionable recommendations based on analysis"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Confidence in analysis quality"
    }
  },
  "required": ["analysis", "recommendations", "confidence"]
}
