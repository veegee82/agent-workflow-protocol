{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "risk_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Calculated risk score"
    },
    "analysis": {
      "type": "string",
      "description": "Detailed risk analysis"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Confidence in the risk assessment"
    }
  },
  "required": ["risk_score", "analysis", "confidence"]
}
