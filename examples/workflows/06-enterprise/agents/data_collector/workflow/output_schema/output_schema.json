{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "collected_data": {
      "type": "object",
      "description": "Structured collected data"
    },
    "data_summary": {
      "type": "string",
      "description": "Summary of collected data"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Confidence in data quality"
    }
  },
  "required": ["collected_data", "data_summary", "confidence"]
}
