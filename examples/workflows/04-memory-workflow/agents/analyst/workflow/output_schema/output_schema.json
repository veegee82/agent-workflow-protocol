{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "analysis": {
      "type": "string",
      "description": "Comprehensive analysis combining current and historical data"
    },
    "insights": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Key insights derived from the analysis"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Confidence in analysis quality"
    }
  },
  "required": ["analysis", "insights", "confidence"]
}
