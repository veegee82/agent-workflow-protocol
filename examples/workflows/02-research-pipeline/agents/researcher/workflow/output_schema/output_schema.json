{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "findings": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Key research findings"
    },
    "sources": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Sources and references used"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Confidence in research findings quality"
    }
  },
  "required": ["findings", "sources", "confidence"]
}
