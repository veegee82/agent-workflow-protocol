{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "analysis": {
      "type": "string"
    },
    "recommendations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "written_to_memory": {
      "type": "boolean"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  },
  "required": ["analysis", "recommendations", "written_to_memory", "confidence"],
  "additionalProperties": false
}
