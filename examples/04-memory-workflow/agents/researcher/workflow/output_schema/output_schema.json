{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "findings": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Research findings from this session"
    },
    "key_facts": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Key facts extracted and saved to memory"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Confidence in research findings"
    }
  },
  "required": ["findings", "key_facts", "confidence"]
}
