{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "processed_data": {
      "type": "string"
    },
    "transformations_applied": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "records_affected": { "type": "integer" }
        },
        "required": ["name", "description"]
      }
    },
    "quality_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  },
  "required": ["processed_data", "transformations_applied", "quality_score", "confidence"],
  "additionalProperties": false
}
