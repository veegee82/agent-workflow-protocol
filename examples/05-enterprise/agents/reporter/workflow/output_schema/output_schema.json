{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "report": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "quality_assessment": {
      "type": "object",
      "properties": {
        "overall_quality": { "type": "string" },
        "quality_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "issues": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["overall_quality", "quality_score"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  },
  "required": ["report", "summary", "quality_assessment", "confidence"],
  "additionalProperties": false
}
