{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "raw_data": {
      "type": "object",
      "description": "Collected raw data"
    },
    "data_quality": {
      "type": "string",
      "description": "Assessment of data quality"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Confidence in data quality"
    }
  },
  "required": ["raw_data", "data_quality", "confidence"]
}
