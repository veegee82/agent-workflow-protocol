{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "task_summary": {
      "type": "string"
    },
    "questions_sent": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  },
  "required": ["task_summary", "questions_sent", "confidence"],
  "additionalProperties": false
}
