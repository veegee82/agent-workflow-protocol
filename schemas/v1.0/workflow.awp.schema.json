{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awp-protocol.org/schemas/v1.0/workflow.awp.schema.json",
  "title": "AWP Workflow Manifest",
  "description": "Schema for workflow.awp.yaml -- the root document of an AWP workflow.",
  "type": "object",
  "required": ["awp", "workflow"],
  "properties": {
    "awp": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.]+)?(\\+[a-zA-Z0-9.]+)?$",
      "description": "AWP specification version (SemVer)."
    },
    "workflow": {
      "type": "object",
      "required": ["name", "version", "description"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,62}[a-z0-9]$",
          "description": "Workflow name in kebab-case or snake_case."
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.]+)?(\\+[a-zA-Z0-9.]+)?$",
          "description": "Workflow version (SemVer)."
        },
        "description": {
          "type": "string",
          "maxLength": 500,
          "description": "Human-readable description of the workflow."
        },
        "author": { "type": "string" },
        "license": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "homepage": { "type": "string", "format": "uri" },
        "repository": { "type": "string" },
        "runtime": {
          "type": "object",
          "properties": {
            "min_awp_version": { "type": "string" },
            "python": { "type": "string", "default": ">=3.10" },
            "required_providers": {
              "type": "array",
              "items": { "type": "string" }
            },
            "required_capabilities": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "dependencies": {
          "type": "object",
          "properties": {
            "tools": { "type": "array" },
            "workflows": { "type": "array" },
            "skills": { "type": "array" },
            "python": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "env": {
          "type": "object",
          "properties": {
            "required": { "type": "array" },
            "defaults": { "type": "object" }
          }
        },
        "settings": {
          "type": "object",
          "properties": {
            "llm": {
              "type": "object",
              "properties": {
                "default_provider": { "type": "string" },
                "models": { "type": "object" },
                "temperature": { "type": "number" }
              }
            },
            "custom": { "type": "object" }
          }
        }
      }
    },
    "orchestration": {
      "type": "object",
      "properties": {
        "engine": { "type": "string", "default": "dag" },
        "graph": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "agent"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,46}[a-z0-9]$"
              },
              "agent": { "type": "string" },
              "enabled": { "type": "boolean", "default": true },
              "depends_on": { "type": "array" },
              "share_input": { "type": "object" },
              "description": { "type": "string" },
              "on_failure": { "type": "string", "enum": ["continue", "skip", "abort"] },
              "timeout": { "type": "integer" },
              "retry": { "type": "integer" }
            }
          }
        },
        "execution": {
          "type": "object",
          "properties": {
            "mode": { "type": "string", "enum": ["sequential", "parallel", "conditional"] },
            "timeout": {
              "type": "object",
              "properties": {
                "per_agent": { "type": "integer" },
                "total": { "type": "integer" }
              }
            },
            "max_parallel_agents": { "type": "integer" },
            "error_handling": { "type": "object" }
          }
        },
        "subworkflows": { "type": "array" }
      }
    },
    "state": { "type": "object" },
    "memory": { "type": "object" },
    "communication": { "type": "object" },
    "observability": {
      "type": "object",
      "properties": {
        "logging": { "type": "object" },
        "metrics": { "type": "object" },
        "tracing": { "type": "object" },
        "audit": { "type": "object" },
        "health": { "type": "object" },
        "evaluation": {
          "type": "object",
          "description": "Optional quality-scoring / evaluation configuration.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "Enable evaluation scoring for this workflow."
            },
            "metrics": {
              "type": "array",
              "description": "Evaluation metrics to compute.",
              "items": {
                "type": "object",
                "required": ["name", "kind"],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Unique metric name."
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "deterministic_test",
                      "deterministic_assertion",
                      "rubric_judge",
                      "budget_utility",
                      "policy_score"
                    ],
                    "description": "Scorer type."
                  },
                  "weight": {
                    "type": "number",
                    "minimum": 0,
                    "default": 1.0,
                    "description": "Weight for weighted-average aggregation."
                  },
                  "params": {
                    "type": "object",
                    "description": "Kind-specific parameters (e.g. expr, assertions)."
                  }
                }
              }
            },
            "thresholds": {
              "type": "object",
              "description": "Score thresholds for accept / retry / fail decisions.",
              "properties": {
                "accept": {
                  "type": "number", "minimum": 0, "maximum": 1, "default": 0.85
                },
                "retry": {
                  "type": "number", "minimum": 0, "maximum": 1, "default": 0.65
                },
                "fail": {
                  "type": "number", "minimum": 0, "maximum": 1, "default": 0.40
                }
              }
            },
            "step_scores": {
              "type": "object",
              "description": "Step-level scoring hooks.",
              "properties": {
                "enabled": { "type": "boolean", "default": true },
                "hooks": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": ["worker_result", "generated_tool", "final_answer"]
                  },
                  "default": ["worker_result", "final_answer"]
                }
              }
            },
            "retry_policy": {
              "type": "object",
              "description": "Score-driven retry / repair policy.",
              "properties": {
                "enabled": { "type": "boolean", "default": false },
                "max_repairs": {
                  "type": "integer", "minimum": 0, "default": 2
                },
                "actions": {
                  "type": "object",
                  "properties": {
                    "below_retry": {
                      "type": "string",
                      "enum": ["retry_with_repair", "fail_workflow", "accept_with_warning"],
                      "default": "retry_with_repair"
                    },
                    "below_fail": {
                      "type": "string",
                      "enum": ["retry_with_repair", "fail_workflow", "accept_with_warning"],
                      "default": "fail_workflow"
                    }
                  }
                }
              }
            },
            "rubric_judge": {
              "type": "object",
              "description": "LLM-based rubric judge configuration.",
              "properties": {
                "model": { "type": "string" },
                "temperature": {
                  "type": "number", "minimum": 0, "maximum": 2, "default": 0.0
                }
              }
            },
            "artifact_path": {
              "type": "string",
              "default": "data/evaluation",
              "description": "Directory for evaluation artifact JSON files."
            }
          }
        }
      }
    },
    "custom_tools": { "type": "object" },
    "dynamic_tools": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Whether any agent MAY create tools at runtime."
        },
        "persist": {
          "type": "boolean",
          "default": false,
          "description": "If true, tool definitions are written to workspace/dynamic_tools/ as JSON manifests."
        },
        "max_total": {
          "type": "integer",
          "default": 50,
          "minimum": 1,
          "description": "Maximum dynamic tools across all agents."
        },
        "allowed_namespaces": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,30}$" },
          "default": ["dynamic"],
          "description": "Namespace prefixes agents MAY use for dynamic tools."
        },
        "code_review": {
          "type": "boolean",
          "default": false,
          "description": "If true, tool code is logged to the audit trail before registration."
        }
      },
      "required": ["enabled"]
    },
    "security": { "type": "object" }
  },
  "additionalProperties": false
}
